# Copy to .env and adjust. Every value has a safe default in src/config.py,
# so the app and the tests run with no .env at all.

# ── Models (served locally by Ollama) ────────────────────────────────
FAST_MODEL=llama3.1:8b
QUALITY_MODEL=llama3.1:70b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector store and documents ───────────────────────────────────────
FAISS_PERSIST_DIR=./data/faiss
DOCUMENTS_DIR=./data/documents

# ── Redis: message broker for Celery AND shared cache (Section VII) ──
REDIS_URL=redis://localhost:6379/0

# ── Retrieval ────────────────────────────────────────────────────────
RETRIEVAL_K=6
MIN_RELEVANCE=0.25

# ── Routing (Section III): intent retrieval, no model call ──────────
ROUTER_MIN_SCORE=0.2
ROUTER_MIN_MARGIN=0.05

# ── Tool selection (Section VI) ──────────────────────────────────────
TOOL_TOP_K=4
HISTORY_TURNS=6

# ── Semantic cache (Section VII) ─────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# ── Long-term memory: Mem0, kept in-house (Section II) ───────────────
MEMORY_DIR=./data/memory
MEMORY_RECALL_K=3

# ── Consuming somebody else's MCP server (Section I) ─────────────────
# The bank's own server runs as a child process and needs no credential.
# A server on the internet does. Leave this blank and the web ingestion
# path refuses to start rather than failing halfway through a scrape.
FIRECRAWL_API_KEY=
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp

# ── Serving ──────────────────────────────────────────────────────────
API_PORT=8100
